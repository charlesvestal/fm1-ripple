/* LOOM-8: the part of <algorithm> Plaits and stmlib use (min, max, swap, fill, copy, sort), for a
 * toolchain with no C++ library. */
#pragma once

namespace std {

template<class T> inline const T& min(const T& a, const T& b) { return b < a ? b : a; }
template<class T> inline const T& max(const T& a, const T& b) { return a < b ? b : a; }
template<class T> inline void swap(T& a, T& b) { T t = a; a = b; b = t; }
template<class It, class T> inline void fill(It first, It last, const T& v) {
  for (; first != last; ++first) *first = v;
}
template<class In, class Out> inline Out copy(In first, In last, Out out) {
  for (; first != last; ++first, ++out) *out = *first;
  return out;
}
/* insertion sort: Plaits sorts a chord's few ratios once, at init */
template<class It> inline void sort(It first, It last) {
  if (first == last) return;
  for (It i = first + 1; i != last; ++i) {
    for (It j = i; j != first && *j < *(j - 1); --j) swap(*j, *(j - 1));
  }
}

}  // namespace std
